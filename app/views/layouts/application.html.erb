<!DOCTYPE html>
<html>
  <head>
    <title>Playdate! The Application - <%= controller_name %>: <%= action_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="<%= feed_url(format: "xml") %>" rel="alternate" title="Atom" type="application/atom+xml">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div id="box" class="wrapper">
      <% if current_player %>
        <div class="logout">
          <p>Ingelogd als <%= h current_player.full_name %>.</p>
          <%= button_to "Uitloggen", destroy_player_session_path, method: :delete %>
        </div>
      <% end %>

      <h1><%= yield :page_title %></h1>

      <div class="content">
        <%= render partial: "shared/showflash" %>
        <%= yield %>
        <% if current_player && current_player.is_admin? %>
          <p>
          <%= link_to "Speeldagen", controller: "playdates", action: "index" %>
          <%= link_to "Spelers", controller: "players", action: "index" %>
          <%= link_to "Hoofd", controller: "main", action: "index" %>
          </p>
        <% end %>
      </div>
      <% if current_player %>
        <p class="logout"><%= link_to "Wachtwoord wijzigen", edit_credentials_path %></p>
      <% end %>
    </div>
  </body>
</html>
