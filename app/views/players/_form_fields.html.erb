<label for="player[name]">Naam:</label>
<%= f.text_field :name %><br>

<label for="player[full_name]">Volledige naam:</label>
<%= f.text_field :full_name %><br>

<label for="player[email]">Email:</label>
<%= f.text_field :email %><br>

<label for="player[abbreviation]">Afkorting:</label>
<%= f.text_field :abbreviation %><br>

<% unless f.object.persisted? %>
  <label for="player[password]">Password:</label>
  <%= f.password_field :password %><br>

  <label for="player[password_confirmation]">Password (nogmaals):</label>
  <%= f.password_field :password_confirmation %><br>
<% end %>

<% unless f.object == current_player %>
  <label for="player[is_admin]">Is Administrator:</label>
  <%= select :player, :is_admin, [["Nee", false], ["Ja", true]] %><br>
<% end %>

<label for="player[default_status]">Standaardstatus:</label>
<%= select :player, :default_status, availability_options %><br>
